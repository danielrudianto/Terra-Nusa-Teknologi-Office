generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int       @id @default(autoincrement())
  name                String    @db.VarChar(100)
  password            String?   @db.VarChar(255)
  email               String?   @unique(map: "email") @db.VarChar(100)
  isActive            Boolean?
  isDeleted           Boolean?
  createdBy           Int?
  createdAt           DateTime  @db.DateTime(0)
  updatedAt           DateTime? @updatedAt @db.DateTime(0)
  deletedAt           DateTime? @db.DateTime(0)
  authenticationLevel Int

  @@map("users")
}

model Supplier {
  id          Int       @id @default(autoincrement())
  prefix      String    @db.VarChar(25)
  name        String    @db.VarChar(255)
  address     String    @db.VarChar(255)
  city        String    @db.VarChar(100)
  province    String    @db.VarChar(100)
  phoneNumber String    @db.VarChar(20)
  email       String?   @db.VarChar(255)
  npwp        String?   @db.VarChar(16)
  itemsSold   String    @db.VarChar(1000)
  serviceArea String    @db.VarChar(1000)
  createdBy   Int
  createdAt   DateTime  @default(now()) @db.DateTime(0)
  updatedBy   Int?
  updatedAt   DateTime? @updatedAt @db.DateTime(0)
  deletedBy   Int?
  deletedAt   DateTime? @db.DateTime(0)
  isDelete    Boolean   @default(false)

  @@map("suppliers")
}

model Purchase {
  id                          Int       @id @default(autoincrement())
  invoiceName                 String    @db.VarChar(100)
  receiptName                 String    @db.VarChar(100)
  taxInvoiceName              String?   @db.VarChar(100)
  supplierID                  Int
  date                        DateTime  @db.Date
  dueDate                     DateTime? @db.Date
  purchaseOrderName           String    @db.VarChar(100)
  projectName                 String    @db.VarChar(100)
  purchaseType                String    @db.VarChar(100)
  procurementType             String    @default("goods") @db.VarChar(45)
  dpp                         Decimal   @db.Decimal(12, 2)
  ppn                         Decimal   @db.Decimal(12, 2)
  pbbkb                       Decimal   @db.Decimal(12, 2)
  pphCode                     String?   @db.VarChar(100)
  pphTaxObject                String?   @db.VarChar(500)
  pphPercentage               Decimal   @db.Decimal(12, 2)
  otherValue                  Decimal?  @db.Decimal(12, 2)
  otherValueNote              String?   @db.VarChar(255)
  isInvoiceAttached           Boolean
  isReceiptAttached           Boolean
  isTaxInvoiceAttached        Boolean
  isCopAttached               Boolean
  isCopyPurchaseOrderAttached Boolean
  bankName                    String    @db.VarChar(100)
  bankAccountName             String    @db.VarChar(100)
  bankAccountNumber           String    @db.VarChar(100)
  paymentMethod               String    @db.VarChar(100)
  isPaid                      Boolean
  isDelete                    Boolean
  createdAt                   DateTime  @db.DateTime(0)
  updatedAt                   DateTime? @updatedAt @db.DateTime(0)
  deletedAt                   DateTime? @db.DateTime(0)
  createdBy                   Int
  updatedBy                   Int?
  deletedBy                   Int?
  lastStatus                  String    @default("draft") @db.VarChar(45)
  isInternal                  Int       @default(0) @db.TinyInt
  lastStatusDescription       String?   @db.VarChar(100)

  @@map("purchases")
}

model PurchaseStatus {
  id          Int      @id @default(autoincrement())
  purchaseID  Int
  status      String   @db.VarChar(100)
  createdBy   Int
  createdAt   DateTime @db.DateTime(0)
  description String?  @db.VarChar(500)

  @@map("purchase_status")
}

model PurchaseOrder {
  id              Int                     @id @default(autoincrement())
  date            DateTime                @db.Date
  supplierID      Int
  name            String                  @db.VarChar(255)
  purchaseType    String                  @db.VarChar(50)
  templateVersion String                  @db.VarChar(50)
  projectName     String                  @db.VarChar(255)
  dpp             Decimal                 @db.Decimal(15, 2)
  status          purchase_orders_status?
  customData      Json?
  ppn             Decimal                 @default(0.00) @db.Decimal(5, 2)
  createdBy       Int
  createdAt       DateTime                @db.DateTime(0)
  isDelete        Boolean?                @default(false)
  deletedBy       Int?
  deletedAt       DateTime?               @db.DateTime(0)

  @@map("purchase_orders")
}

model PurchaseDraft {
  id                Int       @id @default(autoincrement())
  date              DateTime  @db.Date
  supplierID        Int
  description       String    @db.VarChar(100)
  purchaseOrderName String    @db.VarChar(100)
  projectName       String    @db.VarChar(45)
  purchaseType      String    @db.VarChar(45)
  dpp               Decimal   @db.Decimal(15, 2)
  ppn               Decimal   @db.Decimal(12, 2)
  pbbkb             Decimal   @db.Decimal(15, 2)
  isDelete          Int       @default(0) @db.TinyInt
  createdAt         DateTime  @default(now()) @db.DateTime(0)
  createdBy         Int
  deletedAt         DateTime? @db.DateTime(0)
  deletedBy         Int?

  @@map("purchase_draft")
}

model Client {
  id          Int       @id @default(autoincrement())
  prefix      String    @default("") @db.VarChar(10)
  name        String    @db.VarChar(255)
  address     String    @db.VarChar(255)
  city        String    @db.VarChar(100)
  province    String    @db.VarChar(100)
  phoneNumber String    @db.VarChar(20)
  email       String?   @db.VarChar(255)
  npwp        String?   @db.VarChar(50)
  createdAt   DateTime  @default(now())
  createdBy   Int
  updatedAt   DateTime? @updatedAt
  updatedBy   Int?
  isDelete    Boolean   @default(false)
  deletedAt   DateTime?
  deletedBy   Int?

  @@map("clients")
}

model BankAccount {
  id                Int       @id @default(autoincrement())
  bankName          String    @db.VarChar(100)
  bankAccountName   String    @db.VarChar(100)
  bankAccountNumber String    @unique(map: "ix_bank_accounts_bankAccountNumber") @db.VarChar(100)
  isDelete          Boolean   @default(false)
  createdBy         Int
  createdAt         DateTime  @default(now())
  updatedBy         Int?
  updatedAt         DateTime? @updatedAt
  deletedBy         Int?
  deletedAt         DateTime?

  @@map("bank_accounts")
}

model Employee {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)
  nik         String    @unique(map: "nik") @db.VarChar(50)
  birthday    DateTime  @db.Date
  email       String    @unique(map: "email") @db.VarChar(100)
  phoneNumber String    @db.VarChar(20)
  address     String    @db.VarChar(255)
  position    String    @db.VarChar(50)
  department  String    @db.VarChar(50)
  isDelete    Boolean   @default(false)
  taxCategory String    @db.VarChar(10)
  createdAt   DateTime  @default(now())
  createdBy   Int?
  updatedAt   DateTime? @updatedAt
  updatedBy   Int?
  deletedAt   DateTime?
  deletedBy   Int?
  startDate   DateTime? @db.Date
  endDate     DateTime? @db.Date

  @@map("employees")
}

model SalesInvoice {
  id               Int       @id @default(autoincrement())
  name             String    @db.VarChar(100)
  taxInvoiceName   String?   @db.VarChar(45)
  date             DateTime  @db.Date
  projectName      String    @db.VarChar(10)
  clientID         Int
  dpp              Decimal   @db.Decimal(12, 2)
  pphCode          String?   @db.VarChar(100)
  pphTaxObject     String?   @db.VarChar(500)
  pphPercentage    Float     @db.Float
  ppn              Float     @db.Float
  bpjs             Decimal   @default(0.00) @db.Decimal(12, 2)
  spkNumber        String    @db.VarChar(100)
  description      String?   @db.VarChar(100)
  bankAccountID    Int
  createdBy        Int
  createdAt        DateTime  @db.Date
  isApprove        Boolean
  isDelete         Boolean
  updatedBy        Int?
  updatedAt        DateTime? @updatedAt @db.DateTime(0)
  separatedInvoice Int       @default(0) @db.TinyInt

  @@map("sales_invoices")
}

model PaymentOutgoing {
  id              Int       @id @default(autoincrement())
  date            DateTime  @db.Date
  amount          Decimal   @db.Decimal(12, 2)
  purchaseID      Int?
  expenseID       Int?
  reimbursementID Int?
  salarySlipID    Int?
  loanID          Int?
  bankAccountID   Int
  createdAt       DateTime  @default(now()) @db.DateTime(0)
  createdBy       Int
  updatedAt       DateTime? @updatedAt @db.DateTime(0)
  updatedBy       Int?
  isDelete        Boolean?  @default(false)
  isApprove       Boolean?  @default(false)
  status          String    @db.VarChar(50)

  @@map("payment_outgoing")
}

model PaymentIncoming {
  id             Int       @id @default(autoincrement())
  date           DateTime  @db.Date
  amount         Decimal   @db.Decimal(20, 2)
  createdBy      Int
  createdAt      DateTime  @default(now()) @db.DateTime(0)
  incomeID       Int?
  salesInvoiceID Int?
  loanID         Int?
  bankAccountID  Int
  isDelete       Int       @default(0) @db.TinyInt
  deletedBy      Int?
  deletedAt      DateTime? @db.DateTime(0)
  isApprove      Int       @default(0) @db.TinyInt
  updatedBy      Int?
  updatedAt      DateTime? @updatedAt @db.DateTime(0)

  @@map("payment_incoming")
}

model ExpenseOpponent {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(255)
  type          String    @db.VarChar(50)
  description   String?   @db.VarChar(500)
  paymentNumber String?   @db.VarChar(50)
  npwp          String?   @db.VarChar(16)
  createdAt     DateTime  @default(now())
  createdBy     Int
  updatedAt     DateTime? @updatedAt
  updatedBy     Int?
  isDelete      Boolean?  @default(false)
  deletedAt     DateTime?
  deletedBy     Int?

  @@map("expense_opponents")
}

model Expense {
  id                Int       @id @default(autoincrement())
  invoiceName       String    @db.VarChar(100)
  receiptName       String    @db.VarChar(100)
  opponentID        Int?
  date              DateTime  @db.Date
  dueDate           DateTime? @db.Date
  purchaseType      String    @db.VarChar(100)
  dpp               Float
  pbbkb             Float
  pphCode           String?   @db.VarChar(100)
  pphTaxObject      String?   @db.VarChar(500)
  pphPercentage     Float
  bankName          String    @db.VarChar(100)
  bankAccountName   String    @db.VarChar(100)
  bankAccountNumber String    @db.VarChar(100)
  paymentMethod     String    @db.VarChar(100)
  description       String    @db.VarChar(500)
  isPaid            Boolean   @default(false)
  isDelete          Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime? @updatedAt
  deletedAt         DateTime?
  createdBy         Int
  updatedBy         Int?
  deletedBy         Int?

  @@map("expenses")
}

model Reimbursement {
  id                Int       @id @default(autoincrement())
  name              String    @db.VarChar(100)
  date              DateTime  @db.Date
  dueDate           DateTime? @db.Date
  projectName       String    @db.VarChar(100)
  purchaseType      String    @db.VarChar(100)
  bankName          String    @db.VarChar(100)
  bankAccountName   String    @db.VarChar(100)
  bankAccountNumber String    @db.VarChar(100)
  paymentMethod     String    @db.VarChar(100)
  isPaid            Boolean
  isDelete          Boolean
  createdAt         DateTime  @db.DateTime(0)
  updatedAt         DateTime? @updatedAt @db.DateTime(0)
  deletedAt         DateTime? @db.DateTime(0)
  createdBy         Int
  updatedBy         Int?
  deletedBy         Int?
  isApprove         Boolean   @default(false)
  approvedBy        Int?
  approvedAt        DateTime? @db.DateTime(0)

  @@map("reimbursements")
}

model ReimbursementItem {
  id              Int      @id @default(autoincrement())
  reimbursementID Int
  description     String   @db.VarChar(500)
  amount          Decimal  @db.Decimal(12, 2)
  date            DateTime @db.Date

  @@map("reimbursement_items")
}

model Income {
  id          Int       @id @default(autoincrement())
  description String    @db.Text
  date        String    @db.VarChar(45)
  incomeType  String    @db.VarChar(45)
  amount      Decimal   @db.Decimal(20, 2)
  createdBy   Int
  createdAt   DateTime  @default(now()) @db.DateTime(0)
  isDelete    Int       @default(0) @db.TinyInt
  deletedBy   Int?
  deletedAt   DateTime? @db.DateTime(0)
  opponentID  Int

  @@map("income")
}

model SalarySlip {
  id                              Int       @id @default(autoincrement())
  userID                          Int
  month                           Int
  year                            Int
  isPaid                          Boolean
  basicSalary                     Decimal   @db.Decimal(12, 2)
  transportationAllowanceQuantity Decimal   @db.Decimal(12, 2)
  transportationAllowanceRate     Decimal   @db.Decimal(12, 2)
  mealAllowanceQuantity           Decimal   @db.Decimal(12, 2)
  mealAllowanceRate               Decimal   @db.Decimal(12, 2)
  overtimeQuantity                Decimal   @db.Decimal(12, 2)
  overtimeRate                    Decimal   @db.Decimal(12, 2)
  taxAmount                       Decimal   @db.Decimal(12, 2)
  taxCategory                     String    @db.VarChar(50)
  position                        String    @db.VarChar(50)
  department                      String    @db.VarChar(50)
  bankName                        String?   @db.VarChar(100)
  bankAccountName                 String?   @db.VarChar(100)
  bankAccountNumber               String?   @db.VarChar(100)
  paymentMethod                   String?   @db.VarChar(100)
  createdAt                       DateTime  @db.DateTime(0)
  updatedAt                       DateTime? @updatedAt @db.DateTime(0)
  createdBy                       Int
  updatedBy                       Int?
  isDelete                        Boolean
  deletedAt                       DateTime? @db.DateTime(0)
  deletedBy                       Int?

  @@map("salary_slips")
}

model SalarySlipAllowance {
  id           Int     @id @default(autoincrement())
  salarySlipID Int
  name         String  @db.VarChar(100)
  description  String  @db.VarChar(255)
  amount       Decimal @db.Decimal(12, 2)
  isIncluded   Int     @default(0) @db.TinyInt

  @@map("salary_slips_allowances")
}

model SalarySlipDeduction {
  id           Int     @id @default(autoincrement())
  salarySlipID Int
  name         String  @db.VarChar(100)
  description  String  @db.VarChar(255)
  amount       Decimal @db.Decimal(12, 2)
  isIncluded   Int     @db.TinyInt

  @@map("salary_slips_deductions")
}

model Loan {
  id                Int       @id @default(autoincrement())
  date              DateTime  @db.Date
  creditorName      String    @db.VarChar(45)
  creditorAddress   String    @db.Text
  creditorNPWP      String?   @db.VarChar(45)
  description       String    @db.Text
  received          Decimal   @db.Decimal(12, 2)
  debt              Decimal   @db.Decimal(12, 2)
  isPaid            Int       @default(0) @db.TinyInt
  bankAccountName   String    @db.VarChar(45)
  bankAccountNumber String    @db.VarChar(45)
  bankName          String    @db.VarChar(45)
  createdBy         Int
  createdAt         DateTime  @db.DateTime(0)
  updatedBy         Int?
  updatedAt         DateTime? @updatedAt @db.DateTime(0)

  @@map("loans")
}

model Interpayment {
  id                       Int       @id @default(autoincrement())
  bankAccountIDOrigin      Int
  bankAccountIDDestination Int
  amount                   Decimal   @db.Decimal(12, 2)
  description              String    @db.VarChar(150)
  date                     DateTime  @db.Date
  isDelete                 Boolean   @default(false)
  createdBy                Int
  createdAt                DateTime  @default(now()) @db.DateTime(0)
  deletedBy                Int?
  deletedAt                DateTime? @db.DateTime(0)

  @@map("interpayments")
}

model Asset {
  id                Int       @id @default(autoincrement())
  name              String    @db.VarChar(45)
  description       String    @db.VarChar(500)
  brand             String    @db.VarChar(50)
  type              String    @db.VarChar(50)
  depreciation      Int
  location          String    @db.VarChar(50)
  purchaseOrderName String    @db.VarChar(100)
  purchaseDate      DateTime  @db.Date
  value             Float
  createdBy         Int
  createdAt         DateTime  @default(now())
  soldValue         Float?
  soldDate          DateTime? @db.Date
  updatedBy         Int?
  updatedAt         DateTime? @updatedAt

  @@map("assets")
}

model Attendance {
  id          Int       @id @default(autoincrement())
  supplierID  Int
  date        DateTime  @db.Date
  startTime   DateTime  @db.DateTime(0)
  endTime     DateTime? @db.DateTime(0)
  projectName String    @db.VarChar(255)
  isConfirm   Boolean   @default(false)
  isDelete    Boolean   @default(false)
  createdAt   DateTime  @default(now()) @db.DateTime(0)
  createdBy   Int
  updatedAt   DateTime? @updatedAt @db.DateTime(0)
  updatedBy   Int?
  deletedAt   DateTime? @db.DateTime(0)
  deletedBy   Int?

  @@map("attendance")
}

enum purchase_orders_status {
  draft
  approved
  completed
}
